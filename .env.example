# Copy to .env and adjust. All values are optional.

# SQLAlchemy connection string. Default: SQLite file under data/processed.
# PostgreSQL: DATABASE_URL=postgresql+psycopg://risk:secret@localhost:5432/risk_engine
DATABASE_URL=sqlite:///data/processed/risk_engine.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/risk_engine.log

# Configuration files (risk parameters, limits, thresholds and stress scenarios)
RISK_CONFIG_PATH=config/risk_config.yaml
SCENARIOS_PATH=config/scenarios.yaml

# Where generated sample CSVs are written / read
SAMPLE_DATA_DIR=data/sample
